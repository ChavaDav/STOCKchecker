# Server
PORT=3000
NODE_ENV=development

# JWT Secrets (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=cambiar_esto_por_un_secreto_seguro_de_al_menos_64_caracteres
JWT_REFRESH_SECRET=cambiar_esto_por_otro_secreto_seguro_diferente_de_al_menos_64_caracteres

# JWT Expiration
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
DB_PATH=./data/stock-api.db
